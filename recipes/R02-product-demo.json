{
  "$schema": "../schemas/recipe.schema.json",
  "id": "R02",
  "version": 1,
  "name": "Product demo",
  "tier": "B",
  "use_case": "e-commerce, gadgets, beauty; goal: purchase intent",
  "source": {
    "speech": "required"
  },
  "beats": [
    {
      "id": "problem",
      "label": "Problem / hook",
      "share_pct": 15
    },
    {
      "id": "demo",
      "label": "Demo",
      "share_pct": 50
    },
    {
      "id": "result",
      "label": "Result",
      "share_pct": 20
    },
    {
      "id": "cta",
      "label": "Price + CTA",
      "share_pct": 15
    }
  ],
  "hook": {
    "rule": "First line names the problem or the result (\"done in 10 seconds\"), not the product name.",
    "cut_greeting": true,
    "lead_in_ms": 300
  },
  "pacing": {
    "duration_mode": "tighten",
    "wpm": {
      "problem": [
        170,
        170
      ],
      "demo": [
        140,
        160
      ],
      "result": [
        150,
        150
      ],
      "cta": [
        130,
        130
      ]
    },
    "cut_interval_s": [
      3,
      5
    ]
  },
  "captions": {
    "preset": {
      "param": "caption_look"
    },
    "per_beat": {
      "problem": "hook"
    }
  },
  "zoom": {
    "placement": "rhythm",
    "duration_ms": 800
  },
  "sound": {
    "available": "speech",
    "music_bed": {
      "kind": "upbeat"
    },
    "sfx": [
      "whoosh",
      "click"
    ]
  },
  "overlays": [
    {
      "id": "price_cta",
      "kind": "price_card",
      "beat": "cta",
      "required": true
    }
  ],
  "needs": [
    "b_roll"
  ],
  "params": {
    "length_s": {
      "type": "int",
      "default": 30,
      "min": 15,
      "max": 45,
      "label": "How long"
    },
    "cut_fillers": {
      "type": "bool",
      "default": true,
      "label": "Remove ums and pauses"
    },
    "punch_in_every_s": {
      "type": "float",
      "default": 3.0,
      "min": 3,
      "max": 6,
      "label": "How often to zoom in"
    },
    "punch_in_strength": {
      "type": "float",
      "default": 1.15,
      "min": 1.05,
      "max": 1.2,
      "label": "How strong the zoom"
    },
    "caption_look": {
      "type": "enum",
      "default": "bold_box",
      "values": [
        "clean",
        "bold_box",
        "hook"
      ],
      "label": "Caption style"
    }
  },
  "principles": [
    "P-HOOK-3S",
    "P-SHOW-DONT-TELL",
    "P-CTA-ONE"
  ],
  "language": {
    "ar": "Spoken product names stay as spoken (a Latin brand inside Arabic is a mixed line); price digits come from ASR and are eyeballed by Arabic QA.",
    "en": "Base.",
    "fr": "Same as ar."
  }
}
