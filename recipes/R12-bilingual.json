{
  "$schema": "../schemas/recipe.schema.json",
  "id": "R12",
  "version": 1,
  "name": "Bilingual ar/en",
  "tier": "B",
  "golden_set": false,
  "use_case": "education, tech, expat services; goal: reach in two audiences",
  "source": {
    "speech": "required"
  },
  "beats": [
    {
      "id": "hook",
      "label": "Hook in the dominant language",
      "share_pct": 12
    },
    {
      "id": "body",
      "label": "Body",
      "share_pct": 63
    },
    {
      "id": "key_terms",
      "label": "Key terms in both languages",
      "share_pct": 15
    },
    {
      "id": "cta",
      "label": "CTA",
      "share_pct": 10
    }
  ],
  "hook": {
    "rule": "The hook is in one language only (the audience's primary); the second language arrives in the key-term beat.",
    "cut_greeting": true,
    "lead_in_ms": 300
  },
  "pacing": {
    "duration_mode": "tighten",
    "wpm": {
      "hook": [
        140,
        160
      ],
      "body": [
        140,
        160
      ],
      "key_terms": [
        126,
        144
      ],
      "cta": [
        140,
        160
      ]
    }
  },
  "captions": {
    "preset": {
      "param": "caption_look"
    }
  },
  "zoom": {
    "placement": "rhythm",
    "duration_ms": 800
  },
  "sound": {
    "available": "speech"
  },
  "needs": [
    "per_script_size"
  ],
  "params": {
    "length_s": {
      "type": "int",
      "default": 40,
      "min": 25,
      "max": 60,
      "label": "How long"
    },
    "cut_fillers": {
      "type": "bool",
      "default": true,
      "label": "Remove ums and pauses"
    },
    "punch_in_every_s": {
      "type": "float",
      "default": 5.0,
      "min": 3,
      "max": 8,
      "label": "How often to zoom in"
    },
    "punch_in_strength": {
      "type": "float",
      "default": 1.1,
      "min": 1.05,
      "max": 1.2,
      "label": "How strong the zoom"
    },
    "caption_look": {
      "type": "enum",
      "default": "bold_box",
      "values": [
        "clean",
        "bold_box",
        "hook"
      ],
      "label": "Caption style"
    }
  },
  "principles": [
    "P-CODESWITCH-DIR",
    "P-DIALECT-FAITHFUL",
    "P-MUTED-CAPTION"
  ],
  "language": {
    "ar": "An ar line with an en word stays RTL and the Latin run keeps its order.",
    "en": "An en line with an ar word: LTR base.",
    "mixed": "Depends on the EXP-008 per-script size fix (Latin about 1.6x alef height, Sev-2)."
  },
  "notes": "Veto note (creative-lead): not in the golden set or a demo until the EXP-008 size fix passes judging. Compile only (H-0029 addendum)."
}
