{
  "$schema": "../schemas/recipe.schema.json",
  "id": "R09",
  "version": 1,
  "name": "Story hook",
  "tier": "B",
  "use_case": "founder, personal brand; goal: watch time and follows",
  "source": {
    "speech": "required"
  },
  "beats": [
    {
      "id": "cold_open",
      "label": "Cold-open peak line",
      "share_pct": 10
    },
    {
      "id": "setup",
      "label": "Setup",
      "share_pct": 30
    },
    {
      "id": "escalation",
      "label": "Escalation",
      "share_pct": 30
    },
    {
      "id": "twist",
      "label": "Twist / payoff",
      "share_pct": 20
    },
    {
      "id": "loop",
      "label": "Loop / CTA",
      "share_pct": 10
    }
  ],
  "hook": {
    "rule": "Open on the most intriguing line. Today trim can only start the video there (start_at_s); it cannot lift the line to the front and replay the setup.",
    "cut_greeting": true,
    "lead_in_ms": 300
  },
  "pacing": {
    "duration_mode": "tighten",
    "wpm": {
      "setup": [
        140,
        140
      ],
      "escalation": [
        150,
        175
      ],
      "twist": [
        140,
        140
      ]
    },
    "cut_interval_s": [
      3,
      6
    ]
  },
  "captions": {
    "preset": {
      "param": "caption_look"
    },
    "per_beat": {
      "cold_open": "hook"
    }
  },
  "zoom": {
    "placement": "rhythm",
    "duration_ms": 800
  },
  "sound": {
    "available": "speech",
    "music_bed": {
      "kind": "tension_then_silence"
    }
  },
  "structure": {
    "reorder": "cold_open"
  },
  "params": {
    "length_s": {
      "type": "int",
      "default": 45,
      "min": 30,
      "max": 60,
      "label": "How long"
    },
    "start_at_s": {
      "type": "float",
      "default": 0.0,
      "min": 0,
      "max": "source_duration",
      "label": "Start from this moment"
    },
    "cut_fillers": {
      "type": "bool",
      "default": true,
      "label": "Remove ums and pauses"
    },
    "punch_in_every_s": {
      "type": "float",
      "default": 5.0,
      "min": 3,
      "max": 8,
      "label": "How often to zoom in"
    },
    "punch_in_strength": {
      "type": "float",
      "default": 1.12,
      "min": 1.05,
      "max": 1.2,
      "label": "How strong the zoom"
    },
    "caption_look": {
      "type": "enum",
      "default": "clean",
      "values": [
        "clean",
        "bold_box",
        "hook"
      ],
      "label": "Caption style"
    }
  },
  "principles": [
    "P-OPEN-LOOP",
    "P-HOOK-3S",
    "P-PAYOFF-END"
  ],
  "language": {
    "ar": "Storytelling keeps dialect; do not move to MSA for polish.",
    "en": "Base.",
    "fr": "Same."
  }
}
