{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation.schema.json",
  "title": "Annotation record v0.1 (ADR-0023, ADR-0025): one source video or one job",
  "description": "Every label carries label_origin (machine | human_verified). A human_verified label on a source keeps the machine value in machine_value for diffing. Times are integer milliseconds computed by code (I-4). Job keys follow PARTNER_FEEDBACK_FORM FF-v0.1 1:1.",
  "oneOf": [{"$ref": "#/$defs/source_record"}, {"$ref": "#/$defs/job_record"}],
  "$defs": {
    "origin": {"enum": ["machine", "human_verified"]},
    "ms": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights_id": {"type": "string", "pattern": "^RR-([0-9]{3}|P[0-9]{3}-[0-9]{2})$"},
    "version_label": {"type": "string", "pattern": "^[A-Z]$"},
    "lang": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "role": {"enum": ["hook", "product_intro", "demo", "proof", "cta", "other"]},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},

    "label_text": {
      "type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
      "properties": {
        "value": {"type": ["string", "null"], "maxLength": 2000},
        "label_origin": {"$ref": "#/$defs/origin"},
        "machine_value": {"type": ["string", "null"], "maxLength": 2000}
      }
    },
    "label_role": {
      "type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
      "properties": {
        "value": {"$ref": "#/$defs/role"},
        "label_origin": {"$ref": "#/$defs/origin"},
        "machine_value": {"$ref": "#/$defs/role"}
      }
    },
    "label_lang": {
      "type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
      "properties": {
        "value": {"$ref": "#/$defs/lang"},
        "label_origin": {"$ref": "#/$defs/origin"},
        "machine_value": {"$ref": "#/$defs/lang"}
      }
    },

    "keyframe": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "t_ms", "sha256", "label_origin"],
      "properties": {
        "file": {"type": "string", "pattern": "^keyframes/[A-Za-z0-9_.-]+\\.jpg$"},
        "t_ms": {"$ref": "#/$defs/ms"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "label_origin": {"const": "machine"}
      }
    },
    "scene": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "label_origin", "keyframes", "description", "role"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "start_ms": {"$ref": "#/$defs/ms"},
        "end_ms": {"$ref": "#/$defs/ms"},
        "label_origin": {"$ref": "#/$defs/origin"},
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframe"}},
        "description": {"$ref": "#/$defs/label_text"},
        "role": {"$ref": "#/$defs/label_role"}
      }
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "start_ms", "end_ms", "label_origin", "text", "language"],
      "properties": {
        "id": {"type": "integer", "minimum": 0},
        "start_ms": {"$ref": "#/$defs/ms"},
        "end_ms": {"$ref": "#/$defs/ms"},
        "label_origin": {"$ref": "#/$defs/origin"},
        "text": {"$ref": "#/$defs/label_text"},
        "language": {"$ref": "#/$defs/label_lang"}
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["label_origin", "integrated_lufs", "loudness_range_lu", "speech_ratio", "word_count",
                   "words_per_speech_min", "nonspeech_sound_ratio", "energy_db_1s", "flags"],
      "properties": {
        "label_origin": {"const": "machine"},
        "integrated_lufs": {"type": ["number", "null"]},
        "loudness_range_lu": {"type": ["number", "null"]},
        "speech_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "word_count": {"type": "integer", "minimum": 0},
        "words_per_speech_min": {"type": ["number", "null"], "minimum": 0},
        "nonspeech_sound_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "energy_db_1s": {"type": "array", "items": {"type": "number"}},
        "flags": {"type": "array", "uniqueItems": true,
                  "items": {"enum": ["ASR_SUSPICIOUS", "LOW_VAD_SPEECH", "SILENT_TRACK", "NO_AUDIO_STREAM"]}}
      }
    },
    "source_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "annotation_version", "video_id", "rights_id", "media", "provenance",
                   "transcript", "audio", "scenes"],
      "properties": {
        "record_type": {"const": "source"},
        "annotation_version": {"const": "0.1"},
        "video_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "rights_id": {"$ref": "#/$defs/rights_id"},
        "media": {
          "type": "object", "additionalProperties": false,
          "required": ["duration_ms", "width", "height", "fps", "has_audio"],
          "properties": {
            "duration_ms": {"type": "integer", "minimum": 1},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "fps": {"type": "number", "minimum": 0},
            "has_audio": {"type": "boolean"}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["asr_model", "asr_language_requested", "scene_detector", "vad", "rules_version", "describer"],
          "properties": {
            "asr_model": {"type": "string"},
            "asr_language_requested": {"type": "string"},
            "scene_detector": {"type": "string"},
            "vad": {"type": "string"},
            "rules_version": {"type": "string"},
            "describer": {"type": ["string", "null"], "maxLength": 120},
            "corrections": {"type": "array", "items": {"type": "object", "additionalProperties": false,
              "required": ["sha256", "corrected_on"],
              "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "corrected_on": {"$ref": "#/$defs/date"}}}}
          }
        },
        "transcript": {
          "type": "object", "additionalProperties": false,
          "required": ["label_origin", "language", "language_probability", "segments"],
          "properties": {
            "label_origin": {"const": "machine"},
            "language": {"$ref": "#/$defs/label_lang"},
            "language_probability": {"type": "number", "minimum": 0, "maximum": 1},
            "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}}
          }
        },
        "audio": {"$ref": "#/$defs/audio"},
        "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
      }
    },

    "partner_text": {"type": "string", "maxLength": 500},
    "job_record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "annotation_version", "job_id", "partner_id", "rights_ids", "consent_version",
                   "permissions", "training_usable", "brief", "audience", "platform", "objective", "edits_delivered"],
      "properties": {
        "record_type": {"const": "job"},
        "annotation_version": {"const": "0.1"},
        "job_id": {"type": "string", "pattern": "^J-[0-9]{3,}$"},
        "partner_id": {"type": "string", "pattern": "^P[0-9]{3}$"},
        "rights_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rights_id"}},
        "consent_version": {"type": "string", "pattern": "^CK-v[0-9]+\\.[0-9]+$"},
        "permissions": {
          "type": "object", "additionalProperties": false,
          "required": ["evaluation", "product_development", "training_consented"],
          "properties": {
            "evaluation": {"type": "boolean"},
            "product_development": {"type": "boolean"},
            "training_consented": {"type": "boolean"}
          }
        },
        "training_usable": {"const": false},
        "brief": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {"value": {"type": "string", "minLength": 1, "maxLength": 1000}, "label_origin": {"const": "human_verified"}}},
        "audience": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {"value": {"type": "string", "maxLength": 300}, "label_origin": {"const": "human_verified"}}},
        "platform": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {"value": {"enum": ["tiktok", "ig_reels", "yt_shorts", "snapchat", "wa_status", "other"]},
                         "label_origin": {"const": "human_verified"}}},
        "objective": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {
            "value": {"type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": {"kind": {"enum": ["sales", "followers", "awareness", "offer", "other"]},
                             "text": {"type": "string", "maxLength": 300}}},
            "label_origin": {"const": "human_verified"}}},
        "published_version": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {
            "value": {"type": "object", "additionalProperties": false,
              "required": ["published", "version_label", "modified", "file_ref"],
              "properties": {
                "published": {"type": ["boolean", "null"]},
                "version_label": {"anyOf": [{"$ref": "#/$defs/version_label"}, {"type": "null"}]},
                "modified": {"type": ["boolean", "null"]},
                "file_ref": {"type": ["string", "null"], "maxLength": 200}}},
            "label_origin": {"const": "human_verified"}}},
        "likes_dislikes": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {
            "value": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/version_label"},
              "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["likes", "dislikes"],
                "properties": {"likes": {"$ref": "#/$defs/partner_text"}, "dislikes": {"$ref": "#/$defs/partner_text"}}}},
            "label_origin": {"const": "human_verified"}}},
        "edits_delivered": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {
            "value": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
              "required": ["version_label", "recipe_id", "timeline_sha256", "delivered_on"],
              "properties": {
                "version_label": {"$ref": "#/$defs/version_label"},
                "recipe_id": {"type": "string", "pattern": "^[a-z0-9_]{1,64}$"},
                "timeline_sha256": {"$ref": "#/$defs/sha256"},
                "delivered_on": {"$ref": "#/$defs/date"}}}},
            "label_origin": {"const": "machine"}}},
        "partner_choice": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {
            "value": {"type": "object", "additionalProperties": false, "required": ["choice", "display_order"],
              "properties": {
                "choice": {"anyOf": [{"$ref": "#/$defs/version_label"}, {"const": "none"}]},
                "display_order": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/version_label"}}}},
            "label_origin": {"const": "human_verified"}}},
        "corrections": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {
            "value": {"type": "array", "maxItems": 50, "items": {"type": "object", "additionalProperties": false,
              "required": ["version_label", "text", "t_start_ms"],
              "properties": {
                "version_label": {"$ref": "#/$defs/version_label"},
                "text": {"$ref": "#/$defs/partner_text"},
                "t_start_ms": {"anyOf": [{"$ref": "#/$defs/ms"}, {"type": "null"}]}}}},
            "label_origin": {"const": "human_verified"}}},
        "would_publish": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {"value": {"enum": ["as_is", "after_corrections", "no"]}, "label_origin": {"const": "human_verified"}}},
        "would_pay": {"type": "object", "additionalProperties": false, "required": ["value", "label_origin"],
          "properties": {"value": {"enum": ["no", "le_5", "5_15", "gt_15"]}, "label_origin": {"const": "human_verified"}}}
      }
    }
  }
}
