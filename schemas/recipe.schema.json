{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "Recipe v0",
  "description": "A typed edit recipe (H-0029, docs/RECIPE_LANGUAGE.md). A recipe plus a fill (param values) compiles, by code only, to a timeline v0 through src/edit ops. Rules the schema cannot express (beat shares sum to 100, defaults inside ranges, beat references, param bindings) are checked by src.recipe.check_recipe.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "tier",
    "use_case",
    "source",
    "beats",
    "hook",
    "pacing",
    "captions",
    "zoom",
    "sound",
    "params",
    "principles"
  ],
  "$defs": {
    "beat_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "preset": {
      "enum": [
        "clean",
        "bold_box",
        "hook"
      ]
    },
    "num": {
      "type": "number"
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "default"
      ],
      "properties": {
        "type": {
          "enum": [
            "int",
            "float",
            "bool",
            "enum"
          ]
        },
        "default": {
          "type": [
            "integer",
            "number",
            "boolean",
            "string"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "const": "source_duration"
            }
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string",
          "description": "The creator's words for this param (H-0028 section 2)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "int",
                  "float"
                ]
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max"
            ],
            "not": {
              "required": [
                "values"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "bool"
              }
            }
          },
          "then": {
            "properties": {
              "default": {
                "type": "boolean"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "values"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^(R[0-9]{2}|[a-z][a-z0-9_]*)$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tier": {
      "enum": [
        "A",
        "B",
        "C"
      ],
      "description": "Creative's H-0028 tier: A full, B degraded core, C not worth building yet."
    },
    "use_case": {
      "type": "string",
      "minLength": 1
    },
    "golden_set": {
      "type": "boolean",
      "default": true,
      "description": "false = compile only; may not enter the golden set or a demo (R12, EXP-008 Sev-2)."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speech"
      ],
      "properties": {
        "speech": {
          "enum": [
            "required",
            "forbidden",
            "any"
          ],
          "description": "required: a source under SPEECH_MIN_WPM fails E_RECIPE_SOURCE; forbidden: a source at or over it fails E_RECIPE_SOURCE."
        },
        "kind": {
          "enum": [
            "video",
            "images"
          ],
          "default": "video",
          "description": "images: a set of still images (photos_to_video). Image sources cannot be expressed in timeline v0 or rendered today, so a recipe with kind images fails E_RECIPE_SOURCE_KIND."
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "share_pct"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/beat_id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "share_pct": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "repeat_param": {
            "const": "item_count",
            "description": "The beat is split into item_count equal beats <id>1..<id>N sharing share_pct."
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "cut_greeting",
        "lead_in_ms"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1,
          "description": "Editorial rule; advisory (the compiler cannot judge content without a model)."
        },
        "cut_greeting": {
          "type": "boolean",
          "description": "Delete greeting words that start in the first GREETING_WINDOW_MS."
        },
        "lead_in_ms": {
          "type": "integer",
          "minimum": 120,
          "maximum": 2000,
          "description": "If the first word starts later than this, trim the start so it begins PAD_MS (120 ms) before the first word."
        }
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_mode"
      ],
      "properties": {
        "duration_mode": {
          "enum": [
            "tighten",
            "window"
          ],
          "description": "tighten: set_duration (silence longest-first, then the tail); window: trim one continuous window of length_s."
        },
        "wpm": {
          "type": "object",
          "description": "Advisory speech-rate targets per beat id ([min, max] wpm, English base); not enforced.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/num"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "cut_interval_s": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/num"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Advisory; there is no shot-cut op."
        },
        "max_dead_air_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Advisory; set_duration keeps PAD_MS each side of speech."
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "oneOf": [
            {
              "const": "none"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "param"
              ],
              "properties": {
                "param": {
                  "const": "caption_look"
                }
              }
            }
          ]
        },
        "per_beat": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/beat_id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/preset"
          },
          "description": "Wanted per-beat preset. UNRENDERED today (set_caption_style is global)."
        }
      }
    },
    "zoom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement"
      ],
      "properties": {
        "placement": {
          "enum": [
            "rhythm",
            "beats",
            "fraction",
            "none"
          ]
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/beat_id"
          }
        },
        "fraction": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1500,
          "default": 800
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "enum": [
            "speech",
            "source"
          ],
          "description": "What the render carries today: the source audio only."
        },
        "music_bed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string"
            },
            "gain_db": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/num"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "duck_under_speech": {
              "type": "boolean"
            }
          },
          "description": "UNRENDERED today (tracks.audio is UNSUPPORTED_FIELD; no rights-cleared track)."
        },
        "sfx": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "UNRENDERED today."
        }
      }
    },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "description": "Unspoken on-screen text. UNRENDERED today (no text-overlay op or renderer path).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "beat"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "title",
              "price_card",
              "end_card",
              "badge",
              "lower_third",
              "label",
              "brand_card"
            ]
          },
          "beat": {
            "$ref": "#/$defs/beat_id"
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reorder"
      ],
      "properties": {
        "reorder": {
          "enum": [
            "none",
            "cold_open",
            "after_first"
          ],
          "description": "Anything but none is UNRENDERED today (no reorder op)."
        }
      }
    },
    "needs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "transitions",
          "b_roll",
          "stickers",
          "speed_ramp",
          "zoom_ease",
          "beat_sync",
          "keyword_highlight",
          "per_script_size",
          "second_source",
          "image_source",
          "pan_zoom"
        ]
      },
      "description": "Other wanted features; each is reported UNRENDERED."
    },
    "params": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "length_s",
          "cut_fillers",
          "punch_in_every_s",
          "punch_in_strength",
          "caption_look",
          "start_at_s",
          "item_count",
          "seconds_per_image"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/param"
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P-[A-Z0-9-]+$"
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ar": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "mixed": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
